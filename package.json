{
  "name": "pos-system",
  "version": "1.0.0",
  "private": true,
  "description": "POS SYSTEM - Multi-Tenant Retail POS, Billing & Inventory Management SaaS for Kirana and Retail Stores",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test:server": "npm test --workspace=server",
    "seed": "npm run seed --workspace=server"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.4.0"
  },
  "author": "Antigravity Engineering",
  "license": "ISC"
}
